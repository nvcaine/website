{
    "cloudfront": {
        "certificateArn": "arn:aws:acm:us-east-1:975375540779:certificate/f8b6dec3-7bf3-4e55-8ef3-f3326654a40a",

        "props": {
            "defaultRootObject": "index.html",
            "domainNames": ["cdn.stage.romihalasz.com"],
            "enableIpv6": false,
            "errorResponses": [
                {
                    "httpStatus": 403,
                    "responseHttpStatus": 200,
                    "responsePagePath": "/error.html"
                },
                {
                    "httpStatus": 404,
                    "responseHttpStatus": 200,
                    "responsePagePath": "/error.html"
                }
            ]
        }
    },

    "s3": {
        "name": "rhc-app-files-stage",
        "path": "/latest"
    },

    "acl": {
        "ipSetV6": {
            "addresses": ["2a02:2f09:3602:e800:7047:4f89:513b:5473/128"],
            "ipAddressVersion": "IPV6",
            "name": "rhc-allow-list-ipv6",
            "scope": "CLOUDFRONT"
        },

        "ipSetV4": {
            "addresses": ["86.124.142.116/32"],
            "ipAddressVersion": "IPV4",
            "name": "rhc-allow-list-ipv4",
            "scope": "CLOUDFRONT"
        },

        "props": {
            "defaultAction": {
                "block": {}
            },
            "name": "rhc-cdn-acl",
            "scope": "CLOUDFRONT",
            "visibilityConfig": {
                "sampledRequestsEnabled": true,
                "cloudWatchMetricsEnabled": true,
                "metricName": "rhc_acl_metric"
            }
        }
    },

    "route53": {
        "name": "cdn",
        "hostedZone": {
            "hostedZoneId": "Z089843128B8U30FZM0FK",
            "zoneName": "stage.romihalasz.com"
        }
    }
}
