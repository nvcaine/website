{
    "tags": {
        "project": "RHC",
        "env": "stage"
    },
    "cloudfront": {
        "certificateArn": "arn:aws:acm:us-east-1:975375540779:certificate/6cd50db3-9cfe-4c40-ab25-bdc1b796aa84",

        "props": {
            "defaultRootObject": "index.html",
            "domainNames": ["stage.romihalasz.com"],
            "enableIpv6": false,
            "errorResponses": [
                {
                    "httpStatus": 403,
                    "responseHttpStatus": 403,
                    "responsePagePath": "/403.html"
                },
                {
                    "httpStatus": 404,
                    "responseHttpStatus": 404,
                    "responsePagePath": "/404.html"
                }
            ]
        },
        "functions": [
            {
                "comment": "Load the the index.html file for subpages by default",
                "eventType": "viewer-request",
                "functionName": "route-index-handler"
            }
        ]
    },

    "s3": {
        "name": "rhc-app-files-stage",
        "path": "/latest"
    },

    "acl": {
        "ipSets": [
            {
                "addresses": ["2a02:2f09:3703:cd00:8da4:ef52:75ac:6882/128"],
                "ipAddressVersion": "IPV6",
                "name": "rhc-allow-list-ipv6",
                "scope": "CLOUDFRONT"
            },
            {
                "addresses": ["86.125.92.25/32"],
                "ipAddressVersion": "IPV4",
                "name": "rhc-allow-list-ipv4",
                "scope": "CLOUDFRONT"
            }
        ],

        "rules": [
            {
                "name": "GeoBlockRule",
                "priority": 2,
                "action": {
                    "block": {}
                },
                "statement": {
                    "geoMatchStatement": {
                        "countryCodes": ["BY", "CU", "IR", "KP", "RU", "SY"]
                    }
                },
                "visibilityConfig": {
                    "sampledRequestsEnabled": true,
                    "cloudWatchMetricsEnabled": true,
                    "metricName": "rhc_acl_metric_CountryCode"
                }
            },
            {
                "name": "RateLimitRule",
                "priority": 3,
                "action": {
                    "block": {}
                },
                "statement": {
                    "rateBasedStatement": {
                        "limit": 1000,
                        "aggregateKeyType": "IP",
                        "evaluationWindowSec": 300
                    }
                },
                "visibilityConfig": {
                    "sampledRequestsEnabled": true,
                    "cloudWatchMetricsEnabled": true,
                    "metricName": "rhc_acl_metric_RateLimit"
                }
            }
        ],

        "logs": {
            "logGroupName": "aws-waf-logs-rhc-acl",
            "retention": 7,
            "removalPolicy": "destroy"
        },

        "props": {
            "defaultAction": {
                "block": {}
            },
            "name": "rhc-cdn-acl",
            "scope": "CLOUDFRONT",
            "visibilityConfig": {
                "sampledRequestsEnabled": true,
                "cloudWatchMetricsEnabled": true,
                "metricName": "rhc_acl_metric"
            }
        }
    },

    "route53": {
        "hostedZone": {
            "hostedZoneId": "Z089843128B8U30FZM0FK",
            "zoneName": "stage.romihalasz.com"
        }
    }
}
